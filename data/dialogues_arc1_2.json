{
  "description": "第二、三卷劇情對話。",
  "dialogues": {
    "d1_fangshi": {
      "trigger": {
        "loc": "tiannan_fangshi",
        "quest": "CR_MQ10_RuMen",
        "obj": 0
      },
      "nodes": {
        "start": {
          "speaker": "攤主",
          "text": "小哥面生。修士們在坊市裡都拿靈石說話——沒靈石，再好的東西也只能看。這顆突破丹，一百靈石，賣不賣？",
          "choices": [
            {
              "text": "買下（100 靈石）",
              "next": "buy",
              "effects": [
                {
                  "item": "lingshi",
                  "n": -100
                },
                {
                  "item": "pill",
                  "n": 1
                }
              ],
              "require": {
                "item": "lingshi",
                "n": 100
              }
            },
            {
              "text": "只想逛逛，多問問行情",
              "next": "look",
              "effects": [
                {
                  "level": 1
                }
              ]
            }
          ]
        },
        "buy": {
          "speaker": "攤主",
          "text": "爽快。記住，丹藥要在境界瓶頸時吃才有用，平時吃了是浪費。"
        },
        "look": {
          "speaker": "旁白",
          "text": "你在攤位間穿梭，記下了幾種常見靈草的價格，也聽懂了『下品、中品靈石』的兌換規矩。"
        }
      }
    },
    "d1_huangfeng": {
      "trigger": {
        "loc": "huangfeng",
        "quest": "CR_MQ10_RuMen",
        "obj": 1
      },
      "nodes": {
        "start": {
          "speaker": "李化元",
          "text": "你的資質……四靈根，算不得上乘。不過黃楓谷收徒，看重的是心性與肯吃苦。你願入我門下嗎？",
          "choices": [
            {
              "text": "恭敬行禮：弟子願意",
              "next": "yes",
              "effects": [
                {
                  "rep": "huangfenggu",
                  "n": 2
                }
              ]
            },
            {
              "text": "坦言資質平庸，願以勤補拙",
              "next": "honest",
              "effects": [
                {
                  "rep": "huangfenggu",
                  "n": 1
                },
                {
                  "level": 1
                }
              ]
            }
          ]
        },
        "yes": {
          "speaker": "李化元",
          "text": "好。往後在谷中，守規矩，少說話，多做事。"
        },
        "honest": {
          "speaker": "李化元",
          "text": "（微微頷首）能自知者不多。留下吧。"
        }
      }
    },
    "d1_baiyao": {
      "trigger": {
        "loc": "huangfeng",
        "quest": "CR_MQ10_RuMen",
        "obj": 2
      },
      "nodes": {
        "start": {
          "speaker": "旁白",
          "text": "你被派去看管百藥園。園中的靈草長得慢，年份不夠就入不了丹方。你摸了摸懷裡的小瓶。",
          "choices": [
            {
              "text": "悄悄滴一滴靈液在藥苗上",
              "next": "bottle",
              "effects": [
                {
                  "item": "lingye",
                  "n": -1
                },
                {
                  "item": "lingshi",
                  "n": 50
                },
                {
                  "level": 3
                }
              ],
              "require": {
                "item": "lingye",
                "n": 1
              }
            },
            {
              "text": "老老實實澆水除蟲",
              "next": "plain",
              "effects": [
                {
                  "level": 1
                }
              ]
            }
          ]
        },
        "bottle": {
          "speaker": "旁白",
          "text": "幾日後，那株藥苗竟長成了三十年份的模樣。你告誡自己：這件事，絕不能讓任何人知道。"
        },
        "plain": {
          "speaker": "旁白",
          "text": "日復一日，你摸清了每種靈草的脾氣。慢，但穩。"
        }
      }
    },
    "d1_xuese": {
      "trigger": {
        "loc": "xuese",
        "quest": "CR_MQ11_XueSe",
        "obj": 0
      },
      "nodes": {
        "start": {
          "speaker": "旁白",
          "text": "血色禁地的入口被一層淡紅色的霧氣籠罩，每十年才開一次。門派長老再三叮囑：進去的人，不是每個都能出來。",
          "next": "n1"
        },
        "n1": {
          "speaker": "旁白",
          "text": "你握緊法器，踏入紅霧。"
        }
      }
    },
    "d1_yanyue": {
      "trigger": {
        "loc": "yanyue",
        "quest": "CR_MQ11_XueSe",
        "obj": 1
      },
      "nodes": {
        "start": {
          "speaker": "南宮婉",
          "text": "（清冷的目光掃過你）黃楓谷的？血色禁地裡，合歡宗的王蟬也會出現。你我兩派，是聯手，還是各走各的？",
          "choices": [
            {
              "text": "聯手，人多有個照應",
              "next": "team",
              "effects": [
                {
                  "rep": "yanyuezong",
                  "n": 1
                },
                {
                  "flag": "helped_yanyue"
                }
              ]
            },
            {
              "text": "各走各的，但互不相擾",
              "next": "solo",
              "effects": [
                {
                  "flag": "solo_xuese"
                }
              ]
            }
          ]
        },
        "team": {
          "speaker": "南宮婉",
          "text": "……也好。別拖後腿。"
        },
        "solo": {
          "speaker": "南宮婉",
          "text": "隨你。"
        }
      }
    },
    "d1_ruins": {
      "trigger": {
        "loc": "xuese",
        "quest": "CR_MQ11_XueSe",
        "obj": 2
      },
      "nodes": {
        "start": {
          "speaker": "旁白",
          "text": "禁地深處，一座殘破的洞府靜靜立著。石壁上刻著劍痕，你依著痕跡推演，竟悟出了一套劍訣的入門法門。",
          "next": "n1"
        },
        "n1": {
          "speaker": "旁白",
          "text": "青元劍訣——你在心裡默唸這個名字。"
        }
      }
    },
    "d1_material": {
      "trigger": {
        "loc": "huangfeng",
        "quest": "CR_MQ11_XueSe",
        "obj": 3
      },
      "nodes": {
        "start": {
          "speaker": "李化元",
          "text": "築基丹的材料，谷中庫房有一部分。其餘的，你自己想辦法湊齊。",
          "choices": [
            {
              "text": "領取庫房材料，欠下人情",
              "next": "lend",
              "effects": [
                {
                  "flag": "zhuji_material"
                },
                {
                  "rep": "huangfenggu",
                  "n": 1
                }
              ]
            },
            {
              "text": "自行湊齊，不欠人情",
              "next": "own",
              "effects": [
                {
                  "flag": "zhuji_material"
                },
                {
                  "item": "lingshi",
                  "n": -100
                }
              ]
            }
          ]
        },
        "lend": {
          "speaker": "旁白",
          "text": "你領了材料，心裡記下這份人情。"
        },
        "own": {
          "speaker": "旁白",
          "text": "你花光了零碎積蓄，總算把藥材備齊。"
        }
      }
    },
    "d1_alchemy": {
      "trigger": {
        "loc": "huangfeng",
        "quest": "CR_MQ12_ZhuJi",
        "obj": 0
      },
      "nodes": {
        "start": {
          "speaker": "旁白",
          "text": "丹爐前，火候差一分，整爐藥材就會報廢。你想起了那只小瓶。",
          "choices": [
            {
              "text": "用靈液催熟藥材（消耗 1 靈液）",
              "next": "liquid",
              "effects": [
                {
                  "item": "lingye",
                  "n": -1
                },
                {
                  "item": "pill",
                  "n": 2
                },
                {
                  "flag": "zhuji_pill_made"
                }
              ],
              "require": {
                "item": "lingye",
                "n": 1
              }
            },
            {
              "text": "按老方子，穩妥煉製",
              "next": "plain",
              "effects": [
                {
                  "item": "pill",
                  "n": 1
                },
                {
                  "flag": "zhuji_pill_made"
                }
              ]
            }
          ]
        },
        "liquid": {
          "speaker": "旁白",
          "text": "丹成之時，丹香滿室。你一次煉出了兩顆成色極佳的築基丹。"
        },
        "plain": {
          "speaker": "旁白",
          "text": "雖不算完美，但終究成了一顆築基丹。"
        }
      }
    },
    "d1_seclusion": {
      "trigger": {
        "loc": "huangfeng",
        "quest": "CR_MQ12_ZhuJi",
        "obj": 1
      },
      "nodes": {
        "start": {
          "speaker": "李化元",
          "text": "築基是修仙路上第一道真正的門檻。修到練氣圓滿，感到瓶頸鬆動時，再服丹閉關。",
          "next": "n1"
        },
        "n1": {
          "speaker": "旁白",
          "text": "（提示：等級到達上限後，點『突破』按鈕；服用突破丹可大幅提高成功率，失敗則損失一半 HP。）"
        }
      }
    },
    "d1_battle": {
      "trigger": {
        "loc": "yuanwu",
        "quest": "CR_MQ13_ZhengMo",
        "obj": 0
      },
      "nodes": {
        "start": {
          "speaker": "旁白",
          "text": "魔道六宗大舉入侵，越國七派各守一方。戰場上喊殺聲此起彼伏。",
          "next": "n1"
        },
        "n1": {
          "speaker": "旁白",
          "text": "你握緊法器，走進硝煙之中。"
        }
      }
    },
    "d1_dayan": {
      "trigger": {
        "loc": "jihe",
        "quest": "CR_MQ13_ZhengMo",
        "obj": 1
      },
      "nodes": {
        "start": {
          "speaker": "大衍神君",
          "text": "（一縷神識從虛空中浮現）小輩，你身上有意思的東西不少。老夫看中你了。",
          "choices": [
            {
              "text": "不動聲色，探他來意",
              "next": "probe",
              "effects": [
                {
                  "level": 1
                }
              ]
            },
            {
              "text": "拔劍相向，不肯受制",
              "next": "fight",
              "effects": [
                {
                  "hpFrac": -0.3
                }
              ]
            }
          ]
        },
        "probe": {
          "speaker": "大衍神君",
          "text": "（輕笑）謹慎。這份謹慎，日後救你性命。"
        },
        "fight": {
          "speaker": "旁白",
          "text": "一道無形的威壓把你震退數步。你咬牙站穩，知道此刻力量懸殊，只能先記下這筆帳。"
        }
      }
    },
    "d1_nangong": {
      "trigger": {
        "loc": "yanyue",
        "quest": "CR_MQ13_ZhengMo",
        "obj": 2
      },
      "nodes": {
        "start": {
          "speaker": "南宮婉",
          "text": "魔道還有兩處據點未破。你可願與我同去？",
          "choices": [
            {
              "text": "並肩作戰",
              "next": "yes",
              "effects": [
                {
                  "rep": "yanyuezong",
                  "n": 1
                },
                {
                  "flag": "nangong_bond"
                }
              ]
            },
            {
              "text": "我另有安排，先行一步",
              "next": "no"
            }
          ]
        },
        "yes": {
          "speaker": "旁白",
          "text": "兩人默契漸生。戰後，她朝你點了點頭。"
        },
        "no": {
          "speaker": "旁白",
          "text": "你獨自踏上歸路，心中隱約有些遺憾。"
        }
      }
    },
    "d1_retreat": {
      "trigger": {
        "loc": "jixi",
        "quest": "CR_MQ13_ZhengMo",
        "obj": 3
      },
      "nodes": {
        "start": {
          "speaker": "旁白",
          "text": "正魔大戰以正道慘勝告終，但越國元氣大傷。你決定暫別此地，四處遊歷。",
          "next": "n1"
        },
        "n1": {
          "speaker": "旁白",
          "text": "極西之地風沙漫天。前路未卜，你的修為，也已今非昔比。"
        }
      }
    },
    "d1_end": {
      "trigger": {
        "onQuestDone": "CR_MQ13_ZhengMo"
      },
      "nodes": {
        "start": {
          "speaker": "旁白",
          "text": "第二卷·天南 完。你已築基成功，手握青元劍訣，也結識了南宮婉。更大的風浪，正在前方等你。"
        }
      }
    },
    "d2_bamboo": {
      "trigger": {
        "loc": "taiyue",
        "quest": "CR_MQ20_LianQi",
        "obj": 0
      },
      "nodes": {
        "start": {
          "speaker": "旁白",
          "text": "傳聞太岳山脈深處，有一片萬年青竹，是煉製飛劍的絕佳材料。你循著傳聞，一路斬妖開路。"
        }
      }
    },
    "d2_forge": {
      "trigger": {
        "loc": "huangfeng",
        "quest": "CR_MQ20_LianQi",
        "obj": 1
      },
      "nodes": {
        "start": {
          "speaker": "旁白",
          "text": "青竹與金精備齊，該煉劍了。",
          "next": "n1"
        },
        "n1": {
          "speaker": "旁白",
          "text": "（提示：築基期以上、備足靈石，點畫面下方『祭煉青竹蜂雲劍』，即可煉製並升階法寶。）"
        }
      }
    },
    "d2_lingshou": {
      "trigger": {
        "loc": "lingshou",
        "quest": "CR_MQ21_ShiJinChong",
        "obj": 0
      },
      "nodes": {
        "start": {
          "speaker": "靈獸山弟子",
          "text": "噬金蟲？那可是稀罕的靈蟲，以金屬為食，成群時足以蝕穿法寶。你想要，得拿東西來換。",
          "next": "n1"
        },
        "n1": {
          "speaker": "旁白",
          "text": "你以幾份材料換得了一小批蟲卵。"
        }
      }
    },
    "d2_nest": {
