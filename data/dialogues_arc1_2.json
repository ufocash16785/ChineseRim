    "d2_arrive_mulan": {
      "trigger": {
        "arrive": "mulan",
        "quest": "CR_MQ23_MuLan",
        "obj": 1
      },
      "nodes": {
        "start": {
          "speaker": "旁白",
          "text": "踏過界河，眼前是望不到邊的草原。遠處慕蘭人的營火連成一線。",
