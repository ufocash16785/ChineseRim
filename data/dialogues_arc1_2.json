            {
              "text": "耐心以靈草慢慢餵養",
              "next": "slow",
              "effects": [
                {
                  "flag": "insect_nest"
                },
                {
                  "item": "lingshi",
                  "n": 100
                }
              ]
            }
          ]
        },
        "liquid": {
