  "spiritRoots": {
    "description": "靈根 = 角色創建時選擇的『種族』(Skyrim Race)，決定五行親和與修煉速度。",
    "elements": ["金", "木", "水", "火", "土"],
    "types": [
      { "id": "heavenly", "name": "天靈根", "count": 1, "speed": 2.0, "note": "單屬性極品，修煉最快（如：極少數天才）" },
      { "id": "variant", "name": "變異靈根", "count": 1, "speed": 1.8, "elements": ["雷", "冰", "風", "暗"], "note": "如南宮婉所屬掩月宗擅收此類；雷靈根、冰靈根等" },
      { "id": "dual", "name": "雙靈根", "count": 2, "speed": 1.5 },
      { "id": "triple", "name": "三靈根", "count": 3, "speed": 1.2 },
      { "id": "quad", "name": "四靈根", "count": 4, "speed": 1.0, "note": "韓立為四靈根（偽靈根），修煉極慢，依靠掌天瓶催熟靈藥與大衍決彌補" },
      { "id": "penta", "name": "五靈根", "count": 5, "speed": 0.8, "note": "五行雜靈根，最差資質" }
    ]
