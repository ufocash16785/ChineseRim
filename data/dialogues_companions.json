          "speaker": "董萱兒",
          "text": "『它已經三天沒精神了……』她皺著小臉。",
          "choices": [
            {
              "text": "幫她一起照料藥苗",
              "effects": [
                {
                  "affinity": "dongxuaner",
                  "n": 20
                },
                {
                  "flag": "event:dongxuaner"
                }
              ],
              "next": "a"
            },
            {
              "text": "遞上一滴靈液救活它",
              "effects": [
                {
                  "affinity": "dongxuaner",
                  "n": 15
                },
                {
                  "flag": "event:dongxuaner"
                }
              ],
              "next": "b"
