      "nodes": {
        "start": {
          "speaker": "珠中之聲",
          "text": "我曾經，也是一個像你一樣的修士。很久很久以前，我握著這顆珠子，與天道對抗，最後敗了。",
          "next": "n1"
        },
        "n1": {
          "speaker": "珠中之聲",
          "text": "我的肉身死在這座塔裡，殘魂附在珠上，等了無數歲月，等一個『不肯低頭』的人。那個人，是你。",
          "next": "n2"
        },
        "n2": {
          "speaker": "珠中之聲",
          "text": "現在你知道了。天道的本體，就在天罰台的雷雲之後。你要的話，我陪你走完最後一程。若你想放手……我也不怪你。",
          "choices": [
            {
              "text": "「我走到這裡，不是為了放手。」",
              "next": "a",
              "effects": [
                {
                  "flag": "xn_bead_origin"
                }
              ]
            },
            {
              "text": "「我想先救出身邊的人，再談逆天。」",
              "next": "b",
              "effects": [
                {
                  "flag": "xn_bead_origin"
                },
                {
                  "karma": {
                    "ren": 1
                  }
                }
              ]
            }
          ]
        },
        "a": {
          "speaker": "珠中之聲",
          "text": "（笑）好小子，沒看錯你。"
        },
        "b": {
          "speaker": "珠中之聲",
          "text": "……你果然和我當年，不一樣。這是好事。"
        }
      }
    },
