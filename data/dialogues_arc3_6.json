                {
                  "level": 2
                },
                {
                  "learn": "mingqing_lingmu"
                }
              ]
            },
            {
              "text": "坐山觀虎鬥，撿漏",
              "next": "wait",
              "effects": [
                {
                  "flag": "xutian_ding"
                },
                {
                  "item": "lingshi",
                  "n": 200
                },
                {
                  "learn": "mingqing_lingmu"
