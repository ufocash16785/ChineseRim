        "grab": {
          "speaker": "旁白",
          "text": "你冒險搶鼎，雖受了傷，卻拿到了最有利的位置。"
        },
        "wait": {
          "speaker": "旁白",
          "text": "趁對方兩敗俱傷，你悄悄拿到了不少殿中遺落之物。"
        }
      }
    },
    "d3_jiyin": {
      "trigger": {
        "loc": "jiyin",
        "quest": "CR_MQ33_JiYin",
        "obj": 0
      },
      "nodes": {
        "start": {
          "speaker": "旁白",
          "text": "極陰島終年被陰氣籠罩，島上妖物皆偏陰寒。傳說紫羅極火就藏在島心。",
          "next": "n1"
        },
        "n1": {
          "speaker": "旁白",
          "text": "你以自身靈力抵禦陰氣，一路殺進島心。"
        }
      }
    },
    "d3_yuanying": {
      "trigger": {
        "loc": "tianxing_cheng",
        "quest": "CR_MQ34_YuanYing",
        "obj": 0
      },
      "nodes": {
        "start": {
          "speaker": "旁白",
          "text": "結丹到元嬰，是天南千年難遇的關卡。你找到了一處靈氣充足的閉關之地。",
          "next": "n1"
        },
        "n1": {
          "speaker": "旁白",
          "text": "（提示：結丹等級到達上限（60）後，點『突破』；備好突破丹。）"
